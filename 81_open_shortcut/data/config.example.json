{
    "settings": {
        "window_title": "ディレクトリを開く",
        "geometry": "380x640",
        "resizable": [
            true,
            true
        ],
        "icon_folder": "assets/icons",
        "window_icon": "app_icon.ico",
        "default_button_icon": "2025-07-02_17h53_40.png",
        "initial_page": "main_menu",
        "menu_order": "normal"
    },
    "styles": {
        "TButton": {
            "font": [
                "Meiryo UI",
                11
            ],
            "padding": [
                10,
                8
            ],
            "anchor": "w"
        },
        "TLabel": {
            "font": [
                "Meiryo UI",
                11
            ]
        },
        "Status.TLabel": {
            "font": [
                "Meiryo UI",
                10
            ],
            "background": "#23272e",
            "foreground": "#aaaaaa"
        },
        "Header.TLabel": {
            "font": [
                "Meiryo UI",
                13,
                "bold"
            ]
        },
        "Nav.TButton": {
            "font": [
                "Meiryo UI",
                11
            ],
            "padding": [
                10,
                8
            ],
            "anchor": "w",
            "background": "#0f3a3d",
            "foreground": "#4dd0e1"
        },
        "Settings.TButton": {
            "font": [
                "Meiryo UI",
                10
            ],
            "padding": [
                10,
                4
            ],
            "anchor": "center"
        }
    },
    "pages": {
        "main_menu": {
            "title": "メインメニュー",
            "window_title": "メインメニュー",
            "entries": [
                {
                    "name": "テストメニューへ",
                    "action": "show_page",
                    "target": "sub_menu",
                    "icon": null
                },
                {
                    "type": "separator"
                },
                {
                    "name": "各種リンク",
                    "action": "open_url",
                    "url": "https://example.com/links",
                    "icon": null
                },
                {
                    "name": "Documents",
                    "action": "open_directory",
                    "path": "%USERPROFILE%\\Documents",
                    "icon": "2025-07-02_17h53_40.png"
                },
                {
                    "name": "経費精算書",
                    "action": "open_directory",
                    "path": "C:\\path\\to\\sample"
                }
            ]
        },
        "sub_menu": {
            "title": "サブメニュー",
            "window_title": "サブメニュー",
            "menu_order": "global",
            "entries": [
                {
                    "name": "メインメニューへ",
                    "action": "show_page",
                    "target": "main_menu",
                    "icon": null
                },
                {
                    "type": "separator"
                },
                {
                    "name": "サンプルフォルダ",
                    "action": "open_directory",
                    "path": "C:\\path\\to\\sample"
                },
                {
                    "name": "サンプルサイト",
                    "action": "open_url",
                    "url": "https://example.com/"
                }
            ]
        }
    }
}
